{
  "admin": "",
  "interval": 15,
  "liveInterval": 20,
  "timeout": 10,
  "drawEnable": true,
  "notify": false,
  "liveCloseNotify": true,
  "lowSpeed": "0-0x2",
  "cacheClearDays": 7,
  "quality": "1000w",
  "theme": "v3",
  "font": "",
  "defaultColor": "#d3edfa",
  "cardOrnament": "FanCard",
  "downloadOriginal": true,
  "colorGenerator": {
    "hueStep": 30,
    "lockSB": true,
    "saturation": 0.25,
    "brightness": 1
  },
  "badgeEnable": {
    "left": true,
    "right": false
  },
  "pushInterval": 500,
  "messageInterval": 100,
  "atAllPlus": "PLUS_END",
  "template": {
    "dynamic": "OneMsg",
    "live": "OneMsg",
    "liveClose": "SimpleMsg"
  },
  "dynamicTemplates": {
    "DrawOnly": "{draw}",
    "TextOnly": "{name}@{type}\n{link}\n{content}\n{images}",
    "OneMsg": "{draw}\n{name}@{type}\n{link}",
    "TwoMsg": "{draw}\r{name}@{uid}@{type}\n{time}\n{link}",
    "ForwardMsg": "{draw}{>>}作者：{name}\nUID：{uid}\n时间：{time}\n类型：{type}\n链接：{links}\r{content}\r{images}{<<}"
  },
  "liveTemplates": {
    "DrawOnly": "{draw}",
    "TextOnly": "{name}@直播\n{link}\n标题: {title}",
    "OneMsg": "{draw}\n{name}@直播\n{link}",
    "TwoMsg": "{draw}\r{name}@{uid}@直播\n{title}\n{time}\n{link}"
  },
  "liveCloseTemplates": {
    "SimpleMsg": "{name} 直播结束啦!\n直播时长: {duration}",
    "ComplexMsg": "{name} 直播结束啦!\n标题: {title}\n直播时长: {duration}"
  },
  "footer": {
    "dynamicFooter": "",
    "liveFooter": ""
  },
  "proxy": ""
}
